# copy this file to .env (in this backend folder) and put your key in it.
# never share the .env file or upload it to github.

# your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# the Gemini model that reads the photos
GEMINI_MODEL=gemini-3.5-flash-lite

# addresses of the react app that may call this backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
